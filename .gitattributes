# Enforce consistent LF line endings across the repo (the kit ships a mix of
# CRLF originals and LF additions; this normalizes them). After adding this
# file, run once to apply to existing files:  git add --renormalize .

* text=auto eol=lf

# Scripts MUST be LF — CRLF breaks the shebang/parse on Unix shells.
*.sh    text eol=lf
*.bash  text eol=lf

# PowerShell twins — LF is fine for PowerShell 7+ (pwsh), the cross-platform
# shell these .ps1 files target; normalized to LF with the rest of the repo.
*.ps1   text eol=lf

# Markdown, config, and code: text, normalized to LF.
*.md    text eol=lf
*.json  text eol=lf
*.yml   text eol=lf
*.yaml  text eol=lf
*.toml  text eol=lf

# Don't touch binaries.
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.pdf   binary
*.ico   binary

# Generated mirrors of .agents/. Never hand-edit these — they're
# regenerated byte-for-byte by scripts/mirror-agents.sh and
# scripts/mirror-skills.sh. Two effects:
#   - linguist-generated=true collapses them in GitHub PR diffs (reviewers
#     look at .agents/ + the mirror-drift CI check instead).
#   - merge=ours skips line-level merging on these paths entirely, so a
#     three-way merge never leaves conflict markers in generated output.
#     This requires a one-time per-clone step (`git config merge.ours.driver
#     true`), and it is NOT a substitute for
#     regenerating: after any merge that touched .agents/, re-run
#     scripts/mirror-agents.sh and scripts/mirror-skills.sh so the mirrors
#     reflect the merged canonical source, then commit the regenerated
#     files. The pre-commit hook's mirror-drift check (section 4) will
#     catch it if you forget.
.claude/**          linguist-generated=true merge=ours
.codex/**           linguist-generated=true merge=ours
.github/agents/**   linguist-generated=true merge=ours
.github/skills/**   linguist-generated=true merge=ours
